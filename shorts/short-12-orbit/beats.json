        "result": "ORBIT",
        "downrange_deg": 360,
        "downrange_km": null,
        "flight_s": 5545,
        "integratorCheck": "at dt=2 s the radius stays within 6771.000-6771.017 km across a full revolution — 17 m of drift over 40,000 km. The ring closes because the physics closes it, not because we drew a circle."
      }
    ],
    "shotsNote": "the downrange figures above are what the COMPOSITION prints on the ladder, because the composition integrates these arcs itself and measures them — they are not copied here from a scratch calculation. (An early draft of this file said 970 km for the 3 km/s shot, from a rounded 8.7 deg; the code, integrating properly, says 8.67 deg = 960 km. The code won.)",
    "integrator": {
      "method": "velocity Verlet (symplectic — a circular orbit stays circular instead of spiralling in, which is what naive Euler would do over ~1,400 steps)",
      "dt_landing_shots_s": 2,
      "dt_orbit_s": 4,
      "note": "the orbit is integrated 0.4% past one period so the ring visibly closes onto its own tail"
    }
  },
